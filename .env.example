# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Only the anon/public key belongs in a
# browser app — never the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Analytics 4 — leave blank to disable (safe in dev)
# Get from: GA4 → Admin → Data Streams → your stream → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
